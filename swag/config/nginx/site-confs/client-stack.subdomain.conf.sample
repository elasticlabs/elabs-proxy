# swag/config/nginx/site-confs/client-stack.subdomain.conf.sample
#
# Reference example — client stack exposed as a dedicated subdomain.
#
# For automated scaffolding use:
#   make stack-add STACK=my-client PORT=8080 MODE=subdomain
#
# Or copy manually to:
#   swag/config/nginx/site-confs/my-client.subdomain.conf
#
# Then update server_name, upstream service name, and upstream port.
# __BASE_DOMAIN__ is automatically substituted by `make init`.
#
# server {
#     listen 443 ssl;
#     listen [::]:443 ssl;
#
#     server_name my-client.__BASE_DOMAIN__;
#
#     include /config/nginx/ssl.conf;
#
#     # Hardening step 2 — uncomment to enable OIDC on this subdomain.
#     # Validate on the canary first (see docs/adding-a-downstream-stack.md).
#     #location @oauth2_start {
#     #    return 302 /oauth2/start?rd=$scheme://$host$request_uri;
#     #}
#
#     location / {
#         # Hardening step 2 — uncomment to enable OIDC:
#         # include /config/nginx/custom/admin-auth-oidc.conf;
#
#         include /config/nginx/proxy.conf;
#         include /config/nginx/resolver.conf;
#
#         set $upstream_app my-client-app;
#         set $upstream_port 8080;
#         set $upstream_proto http;
#         proxy_pass $upstream_proto://$upstream_app:$upstream_port;
#     }
# }